      "id": "c65c0f9e-edd1-4abc-9633-6367f7130726",
      "name": "Get Issue Details",
      "notes": "Testing automated Redmine activity detection for Mattermost."
    },
    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n  const issue = item.json.issue;\n  const journals = issue.journals || [];\n\n  const activities = [];\n\n  for (const journal of journals) {\n    const author = journal.user?.name || 'Unknown';\n    const createdOn = journal.created_on;\n\n    for (const detail of journal.details || []) {\n\n      if (detail.name === 'status_id') {\n        activities.push({\n          type: 'status_changed',\n          author: author,\n          old_value: detail.old_value,\n          new_value: detail.new_value,\n          created_on: createdOn\n        });\n      }\n\n      if (detail.name === 'done_ratio') {\n        activities.push({\n          type: 'progress_changed',\n          author: author,\n          old_value: detail.old_value,\n          new_value: detail.new_value,\n          created_on: createdOn\n        });\n      }\n    }\n\n    if (journal.notes && journal.notes.trim() !== '') {\n      activities.push({\n        type: 'comment_added',\n        author: author,\n        note: journal.notes,\n        created_on: createdOn\n      });\n    }\n  }\n\n  output.push({\n    json: {\n      issue: issue,\n      activities: activities\n    }\n  });\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3216,
        -816
      ],
      "id": "3199c08b-6241-48a9-86dc-393b2876fd4b",
