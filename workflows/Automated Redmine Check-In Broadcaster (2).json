        -720
      ],
      "id": "ff8d3306-1dfc-45be-8895-7b1c44c10151",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const issue = item.json.issue;\n  const activities = [...(item.json.activities || [])];\n  const timeEntries = item.json.time_entries || [];\n\n  // Convert logged time into an activity\n  for (const entry of timeEntries) {\n    activities.push({\n      type: 'time_logged',\n      author: entry.user?.name || 'Unknown',\n      hours: entry.hours,\n      comments: entry.comments || '',\n      spent_on: entry.spent_on || null,\n      activity_id: entry.id\n    });\n  }\n\n  results.push({\n    json: {\n      issue,\n      activities,\n      has_activity: activities.length > 0\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2544,
        -720
      ],
      "id": "1e99ad01-38a8-4bce-a69e-fa174fe521b2",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "fa220f88-9079-4de9-b82d-f29a5514080f",
              "leftValue": "={{$json.has_activity}}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -2320,
        -720
      ],
      "id": "811a8f94-7085-4e46-b238-5ed427d092c2",
      "name": "If"
    },
    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n\n  // Support both nested and flattened issue structures\n  const issue = data.issue || data;\n\n  const activities = data.activities || [];\n\n  const projectName =\n    issue.project?.name ||\n    data.project?.name ||\n    'Unknown';\n\n  const subject =\n    issue.subject ||\n    data.subject ||\n    'Unknown';\n\n  const priority =\n    issue.priority?.name ||\n    data.priority?.name ||\n    'Unknown';\n\n  const status =\n    issue.status?.name ||\n    data.status?.name ||\n    'Unknown';\n\n  const issueId =\n    issue.id ||\n    data.id ||\n    'Unknown';\n\n  const activityText = activities.map(activity => {\n    switch (activity.type) {\n      case 'status_changed':\n        return `• Status changed: ${activity.old_value || 'Unknown'} → ${activity.new_value || 'Unknown'} by ${activity.author}`;\n\n      case 'progress_changed':\n        return `• Progress changed: ${activity.old_value || '0'}% → ${activity.new_value || '0'}% by ${activity.author}`;\n\n      case 'comment_added':\n        return `• Comment added by ${activity.author}: ${activity.note}`;\n\n      case 'time_logged':\n        return `• Time logged: ${activity.hours}h by ${activity.author}${activity.comments ? ` — ${activity.comments}` : ''}`;\n\n      default:\n        return `• Activity: ${activity.type}`;\n    }\n  }).join('\\n');\n\n  output.push({\n    json: {\n      issue_id: issueId,\n      project: projectName,\n      subject: subject,\n      priority: priority,\n      status: status,\n\n      message: `### Redmine Check-in Update\n\n**Project:** ${projectName}\n\n**Issue:** #${issueId} — ${subject}\n\n**Priority:** ${priority}\n\n**Status:** ${status}\n\n**Activity:**\n${activityText}`\n    }\n  });\n}\n\nreturn output;"
      },
